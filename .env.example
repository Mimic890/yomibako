# Copy to .env:  cp .env.example .env
# Docker Compose reads this file automatically.

# Shared secret between Yomibako and BookOrbit (indexer setting "Yomibako token").
# Empty = no authentication. Generate one with: openssl rand -hex 32
YOMIBAKO_TOKEN=

# GID that owns the Docker socket on the host, so the non-root container may use it:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Optional: pin the published Yomibako image instead of :latest, or point it at your
# own build. The GHCR package is public; if a pull is denied, `docker login ghcr.io`.
# YOMIBAKO_IMAGE=ghcr.io/mimic890/yomibako:latest

# Optional overrides for the miwayomi service. Compose pins one upstream release
# (0.2.9) for both values; override them with a tag of your own image in production.
# MIWAYOMI_IMAGE=ghcr.io/miwayomi/miwayomi:0.2.9
# MIWAYOMI_BUILD_CONTEXT=https://github.com/miwayomi/miwayomi.git#v0.2.9
