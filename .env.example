# Copy to .env:  cp .env.example .env
# Docker Compose reads this file automatically.

# Shared secret between Yomibako and BookOrbit (indexer setting "Yomibako token").
# Empty = no authentication. Generate one with: openssl rand -hex 32
YOMIBAKO_TOKEN=

# GID that owns the Docker socket on the host, so the non-root container may use it:
#   stat -c '%g' /var/run/docker.sock
DOCKER_GID=999

# Optional overrides for the miwayomi service.
# MIWAYOMI_IMAGE=ghcr.io/miwayomi/miwayomi:latest
# MIWAYOMI_BUILD_CONTEXT=https://github.com/miwayomi/miwayomi.git#main
